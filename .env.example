# Copy to .env for local development. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wearduds_club"
DATABASE_POOL_SIZE=10

# Set by `shopify app dev` locally; set by hand on Railway.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://wearduds-loyalty-app-production-4a64.up.railway.app
SCOPES=read_customers,write_customers,read_orders,write_discounts,write_store_credit_account_transactions

# Hourly jobs (see scripts/cron.mjs). Use a long random string.
CRON_SECRET=

# Instagram follow verification (optional; Settings > Integrations shows status)
META_APP_SECRET=
META_VERIFY_TOKEN=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v24.0
INSTAGRAM_SHOP=wearduds.myshopify.com
